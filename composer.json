{
    "name": "stfalcon-studio/swagger-bundle",
    "description": "Generate Swagger UI documentation from local files",
    "keywords": ["bundle", "symfony", "swagger", "openapi"],
    "homepage": "https://github.com/stfalcon-studio/swagger-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/stfalcon-studio/swagger-bundle/issues"
    },
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/asset": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/polyfill-ctype": "^1.33",
        "twig/twig": "^3.23"
    },
    "require-dev": {
        "escapestudios/symfony2-coding-standard": "^3.18",
        "friendsofphp/php-cs-fixer": "^v3.90",
        "phpstan/phpstan": "^2.1.32",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.5",
        "rregeer/phpunit-coverage-check": "^0.3.1",
        "symfony/dotenv": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "StfalconStudio\\SwaggerBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "StfalconStudio\\SwaggerBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "ci:pack": [
            "@ci:composer-validate",
            "@ci:psr-check",
            "@ci:code-style",
            "@ci:static-analysis",
            "@ci:phpunit"
        ],
        "ci:composer-validate": "@composer validate --no-check-all",
        "ci:psr-check": "@composer dump-autoload --dry-run --strict-psr --optimize",
        "ci:code-style": [
            "vendor/bin/phpcs --standard=phpcs.xml",
            "vendor/bin/php-cs-fixer fix --dry-run --config=.php-cs-fixer.php -v"
        ],
        "ci:static-analysis": [
            "XDEBUG_MODE=off vendor/bin/phpstan analyse --no-progress -c phpstan.neon ./"
        ],
        "ci:phpunit": [
            "export XDEBUG_MODE=coverage && vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover=clover-coverage.xml",
            "vendor/bin/coverage-check clover-coverage.xml 100"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
